{
  "id": "eng-manager",
  "title": "Engineering manager",
  "accent": "#b4531f",
  "widgets": ["now", "people-roster", "commitments", "one-on-one", "meeting-load", "team-pulse", "weekly-update", "agenda", "task-list", "activity", "quick-capture"],
  "task_types": [
    {
      "id": "em.person",
      "title": "Person",
      "icon": "user",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "role": { "type": "string", "minLength": 1, "maxLength": 120 },
          "team": { "type": "string", "minLength": 1, "maxLength": 120 },
          "start_date": { "type": "string", "format": "date", "maxLength": 10 },
          "timezone": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_+/-]*$", "maxLength": 64 },
          "cadence_days": { "type": "integer", "minimum": 1, "maximum": 90 },
          "last_one_on_one": { "type": "string", "format": "date", "maxLength": 10 },
          "growth_goals": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
          "email": { "type": "string", "format": "email", "maxLength": 254 }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "display": { "primary_fields": ["role", "team"], "badge_field": "team" }
    },
    {
      "id": "em.commitment",
      "title": "Commitment",
      "icon": "handshake",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "direction": { "enum": ["i_owe", "waiting_on"] },
          "person_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "minLength": 1, "maxLength": 64 },
          "counterpart": { "type": "string", "minLength": 1, "maxLength": 120 },
          "what": { "type": "string", "minLength": 1, "maxLength": 300 },
          "promised_on": { "type": "string", "format": "date", "maxLength": 10 },
          "due": { "type": "string", "format": "date", "maxLength": 10 },
          "source": { "enum": ["meeting", "slack", "email", "manual"] },
          "status": { "enum": ["open", "done", "dropped"] }
        },
        "required": ["direction", "what"],
        "additionalProperties": false
      },
      "display": { "primary_fields": ["direction", "counterpart", "due"], "badge_field": "direction" }
    },
    {
      "id": "em.one_on_one",
      "title": "One-on-one",
      "icon": "users",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "person_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "minLength": 1, "maxLength": 64 },
          "scheduled_for": { "type": "string", "format": "date-time", "maxLength": 40 },
          "agenda": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 300 },
                "added_by": { "enum": ["me", "them", "agent"] },
                "carried_over": { "type": "boolean" },
                "done": { "type": "boolean" }
              },
              "required": ["text"],
              "additionalProperties": false
            }
          },
          "status": { "enum": ["scheduled", "in_progress", "done", "cancelled"] },
          "started_at": { "type": "string", "format": "date-time", "maxLength": 40 },
          "ended_at": { "type": "string", "format": "date-time", "maxLength": 40 }
        },
        "required": ["person_id"],
        "additionalProperties": false,
        "x-halp-ext-writable": ["scheduled_for"]
      },
      "display": { "primary_fields": ["person_id", "scheduled_for"], "badge_field": "status" }
    },
    {
      "id": "em.meeting",
      "title": "Meeting",
      "icon": "calendar-clock",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "starts_at": { "type": "string", "format": "date-time", "maxLength": 40 },
          "ends_at": { "type": "string", "format": "date-time", "maxLength": 40 },
          "location": { "type": "string", "maxLength": 200 },
          "url": { "type": "string", "format": "uri", "maxLength": 2048 },
          "busy": { "type": "boolean" },
          "attendees_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "organizer_is_me": { "type": "boolean" },
          "recurring": { "type": "boolean" },
          "category": { "enum": ["1on1", "team", "cross-team", "external", "focus"] }
        },
        "required": ["starts_at", "ends_at"],
        "additionalProperties": false
      },
      "display": { "primary_fields": ["starts_at", "category"], "badge_field": "category" }
    },
    {
      "id": "em.team_signal",
      "title": "Team signal",
      "icon": "activity",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "team": { "type": "string", "minLength": 1, "maxLength": 120 },
          "period": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$", "maxLength": 8 },
          "merged_prs": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "cycle_time_p50_hours": { "type": "number", "minimum": 0, "maximum": 10000 },
          "open_incidents": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "review_wait_p50_hours": { "type": "number", "minimum": 0, "maximum": 10000 }
        },
        "required": ["team", "period"],
        "additionalProperties": false
      },
      "display": { "primary_fields": ["team", "period"], "badge_field": "period" }
    },
    {
      "id": "em.private_note",
      "title": "Private note",
      "icon": "lock",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "x-halp-data-class": "notes.private",
        "type": "object",
        "properties": {
          "person_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "minLength": 1, "maxLength": 64 },
          "body": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "created_at": { "type": "string", "format": "date-time", "maxLength": 40 }
        },
        "required": ["person_id", "body"],
        "additionalProperties": false
      },
      "display": { "primary_fields": ["person_id"] }
    }
  ],
  "layout": {
    "id": "eng-manager-default",
    "role_id": "eng-manager",
    "columns": 12,
    "widgets": [
      { "id": "now", "kind": "now", "title": "Now", "x": 0, "y": 0, "w": 4, "h": 3, "config": {} },
      { "id": "people-roster", "kind": "people-roster", "title": "People", "x": 4, "y": 0, "w": 5, "h": 4, "config": { "sort": "next" } },
      { "id": "meeting-load", "kind": "meeting-load", "title": "Meeting load", "x": 9, "y": 0, "w": 3, "h": 4, "config": { "budget_hours": 16, "day_start": "09:00", "day_end": "17:00" } },
      { "id": "commitments", "kind": "commitments", "title": "Commitments", "x": 0, "y": 3, "w": 4, "h": 5, "config": {} },
      { "id": "one-on-one", "kind": "one-on-one", "title": "One-on-one", "x": 4, "y": 4, "w": 5, "h": 5, "config": {} },
      { "id": "agenda", "kind": "agenda", "title": "Agenda", "x": 9, "y": 4, "w": 3, "h": 4, "config": { "days": 7 } },
      { "id": "weekly-update", "kind": "weekly-update", "title": "Weekly update", "x": 0, "y": 8, "w": 4, "h": 4, "config": {} },
      { "id": "team-pulse", "kind": "team-pulse", "title": "Team pulse", "x": 9, "y": 8, "w": 3, "h": 4, "config": { "weeks": 6 } },
      { "id": "task-list", "kind": "task-list", "title": "My tasks", "x": 4, "y": 9, "w": 5, "h": 3, "config": { "preset": "open" } }
    ]
  }
}
