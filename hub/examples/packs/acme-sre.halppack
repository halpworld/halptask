{"format":"halp-pack/1","manifest":"{\n  \"description\": \"Example pack: an on-call role that extends the developer role with an incident task type, a computed open-incident metric (a sandboxed WebAssembly transform) and a sandboxed on-call widget.\",\n  \"extends\": {\n    \"id\": \"halp.developer\",\n    \"version\": \"^0.1\"\n  },\n  \"files\": {\n    \"prompts/oncall-handoff.md\": {\n      \"sha256\": \"b70d0014f4eaf933f382f80fc7a3bcb04d4a3b38610d70c6a985bc7963947dac\",\n      \"size\": 517\n    },\n    \"readme.md\": {\n      \"sha256\": \"86cbb0d74554574e458a36ec3b3ac988ae0a35f76bc70a725860e633f9c6c33f\",\n      \"size\": 4832\n    },\n    \"ui/oncall/index.html\": {\n      \"sha256\": \"331b62bde05c2f86a60c2d84b502c964d0d33ba77e22dc3789bc8dd6c3a8a7f5\",\n      \"size\": 1080\n    },\n    \"ui/oncall/oncall.js\": {\n      \"sha256\": \"3f6dcb1e458db6838b8a86e66e0fe8b2b12e3b682182847b84aafe8f32bf0f3c\",\n      \"size\": 3057\n    },\n    \"wasm/burn.wasm\": {\n      \"sha256\": \"eab200d9c7e53573e4367aa87fde428923d227087a9f2cfa797a4c0164e80d5d\",\n      \"size\": 666\n    },\n    \"wasm/burn.wat\": {\n      \"sha256\": \"281c836707f2d3ccb09e6ac8734c9d6bcd1ae21d042d50835c44703e5730870c\",\n      \"size\": 4444\n    }\n  },\n  \"format\": 1,\n  \"id\": \"acme.platform-sre\",\n  \"license\": \"MIT\",\n  \"min_hub\": \"0.x\",\n  \"modules\": [\n    {\n      \"inputs\": {\n        \"open\": {\n          \"args\": {\n            \"status\": [\n              \"todo\",\n              \"in_progress\"\n            ],\n            \"type_id\": \"acme.incident\"\n          },\n          \"command\": \"tasks.list\"\n        }\n      },\n      \"name\": \"burn\",\n      \"output_schema\": {\n        \"properties\": {\n          \"hint\": {\n            \"type\": \"string\"\n          },\n          \"label\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"minimum\": 0,\n            \"type\": \"integer\"\n          }\n        },\n    